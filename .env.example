# AI / Hugging Face
HF_TOKEN=

# Optional external AI API
OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Google Earth Engine
GOOGLE_PROJECT_ID=

# Sentinel Hub
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# Database
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/database_name
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Redis
REDIS_URL=

# Application
ENVIRONMENT=development
# Must point at a durable mounted filesystem in production. Object storage is not
# yet implemented by this prototype.
SATQUERY_STORAGE_ROOT=

# CORS Configuration
# Comma-separated list of allowed origins. Example: https://satquery.example.com
SATQUERY_CORS_ORIGINS=*

# Vision Provider Options
# SATQUERY_VISION_MODEL=HuggingFaceTB/SmolVLM-256M-Instruct
# SATQUERY_VISION_ALLOW_DOWNLOAD=false

# Change Detection Options
# SATQUERY_BIT_CHECKPOINT=
